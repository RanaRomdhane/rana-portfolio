# --- AI assistant (required for the chat) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Voice clone (optional: without it the browser's built-in voice is used) ---
FISH_API_KEY=
FISH_VOICE_ID=
FISH_MODEL=s2.1-pro-free

# --- Silent visitor alerts on Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Public site address (used for SEO / social previews) ---
NEXT_PUBLIC_SITE_URL=https://rana-portfolio-wheat.vercel.app
